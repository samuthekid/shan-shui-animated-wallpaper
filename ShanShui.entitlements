<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <!-- Replace TEAMID_HERE with the team ID in the provisioning profile. Do not guess it. -->
  <key>com.apple.application-identifier</key><string>TEAMID_HERE.com.samuapps.shanshui</string>
  <key>com.apple.developer.team-identifier</key><string>TEAMID_HERE</string>
</dict>
</plist>
